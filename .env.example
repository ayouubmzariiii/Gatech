# Public URL of the site, no trailing slash (used for canonicals, sitemap, structured data)
SITE_URL=https://gatech.world

# Optional: every contact-form lead is POSTed here as JSON (Zapier, Make, n8n, HubSpot, Slack…)
CONTACT_WEBHOOK_URL=

# Search engine verification tokens
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Set automatically by Vercel ("production" | "preview" | "development"); previews are noindexed.
# VERCEL_ENV=
